# ─────────────────────────────────────────────────────────────
# AU Forex Academy — environment variables
# Copy to `.env` (local) or set in your hosting dashboard.
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (required). Used by migrations; also by the app unless
# DATABASE_URL_POOLED is set. On Vercel the Prisma Postgres integration sets it (db.prisma.io).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/auforex"
# Optional: pooled connection for the running app (Prisma Postgres: same string, host
# pooled.db.prisma.io). Recommended on Vercel — avoids "too many connections" (P2037).
DATABASE_URL_POOLED=""
# Optional: direct connection for Prisma CLI (migrations) when DATABASE_URL is a pooled one.
DIRECT_URL=""
# Optional: connections per server instance (default 2 on Vercel, 10 elsewhere).
DB_POOL_MAX=""
# Host port of the `docker compose` database. Must match the port in DATABASE_URL.
DB_PORT="5432"

# Auth (required). Generate a secret with:  openssl rand -base64 48
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
# Public base URL of the site (used for auth callbacks, email links, CSRF origin checks)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Extra allowed origins, comma separated (e.g. a www/non-www variant)
TRUSTED_ORIGINS=""

# File storage.
#  - "local": private files on disk outside /public (needs a persistent volume in production).
#  - "s3": S3-compatible object storage (Cloudflare R2 recommended). REQUIRED on Vercel — its disk
#    is read-only. Leave STORAGE_DRIVER empty to use S3 automatically when all S3_* values are set.
#    Setup (bucket, token, CORS exposing ETag): docs/FAYL-SAQLASH.md
STORAGE_DRIVER=""
STORAGE_LOCAL_ROOT="./storage"
# R2 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com (without the bucket name)
S3_ENDPOINT=""
S3_BUCKET=""
# "auto" for R2; the AWS region for S3
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MAX_VIDEO_UPLOAD_MB="2048"
MAX_BOOK_UPLOAD_MB="100"
MAX_IMAGE_UPLOAD_MB="5"

# Optional: lesson videos on Bunny Stream (alternative to uploading into S3/R2). Bunny → Stream → your library →
# Security → enable "Embed view token authentication" and copy the "Token authentication key".
# With it set, PRO viewers get links that expire after 6 hours. Leave empty while not using Bunny.
BUNNY_STREAM_TOKEN_KEY=""

# Email (required in production for registration verification and password reset).
# SMTP_HOST and MAIL_FROM must be set together. SMTP_USER/SMTP_PASSWORD are a pair
# for providers that require authentication. 587 usually uses SMTP_SECURE=false;
# port 465 usually uses SMTP_SECURE=true. Without SMTP, sign-up/reset mail flows fail.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""
# Set to "false" only if intentionally allowing unverified sign-in in production.
REQUIRE_EMAIL_VERIFICATION=""

# Founder = SUPER_ADMIN (created by `npm run db:seed`). Signs in with the login below.
# If FOUNDER_PASSWORD is empty when the account is first created, the seed generates
# a strong password and prints it once. Use a real FOUNDER_EMAIL for password recovery.
FOUNDER_USERNAME="asadbek"
FOUNDER_EMAIL="founder@auforex.local"
FOUNDER_PASSWORD=""
FOUNDER_NAME="Asadbek Uktambekov"

# Optional additional super admin (used by `npm run db:seed` / `npm run admin:create`).
# Leave ADMIN_EMAIL empty if the founder is the only admin.
# To create one: set both ADMIN_EMAIL and ADMIN_PASSWORD (12+ characters, letters and digits).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="AU Admin"

# Vercel build (scripts/vercel-build.mjs). Defaults: migrations on production deploys only, seed never.
# MIGRATE_ON_BUILD="true|false"
# SEED_ON_BUILD="true"
