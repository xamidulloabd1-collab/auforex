{
  "name": "au-forex-academy",
  "version": "1.0.0",
  "private": true,
  "description": "AU Forex Academy — premium Forex education platform",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/preflight.mjs dev",
    "build": "next build",
    "prebuild": "node scripts/preflight.mjs build && node scripts/copy-pdf-worker.mjs",
    "start": "next start",
    "setup": "node scripts/setup.mjs",
    "doctor": "tsx scripts/doctor.ts",
    "db:fix": "node scripts/db-fix.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "founder:password": "tsx scripts/founder-password.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate && node scripts/copy-pdf-worker.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@hookform/resolvers": "^7.0.7",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "nodemailer": "^10.6.1",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true,
    "fsevents": true
  }
}
